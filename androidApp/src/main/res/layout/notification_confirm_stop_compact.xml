<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed stop-confirmation notification: question plus Keep and Stop buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/notification_title_stop_confirm"
        android:textColor="@color/notification_foreground"
        android:textSize="@dimen/notification_title_text_size" />

    <Button
        android:id="@+id/btn_notification_cancel_stop"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/notification_action_button_size"
        android:text="@string/notification_confirm_stop_compact_keep"
        android:textColor="@color/notification_foreground" />

    <Button
        android:id="@+id/btn_notification_confirm_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/notification_badge"
        android:minHeight="@dimen/notification_action_button_size"
        android:text="@string/notification_confirm_stop_compact_stop"
        android:textColor="@android:color/white" />
</LinearLayout>
