<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded session notification: status detail, live timer, save count, Rewind and Stop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_cache_dot"
            tools:src="@drawable/bg_notification_cache_replacing"
            android:layout_width="@dimen/notification_cache_dot_size"
            android:layout_height="@dimen/notification_cache_dot_size"
            android:layout_marginEnd="@dimen/notification_cache_dot_margin_end" />

        <TextView
            android:id="@+id/notification_title"
            tools:text="@string/notification_title_recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_title_recording"
            android:textColor="@color/notification_foreground_muted"
            android:textSize="@dimen/notification_title_text_size" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/notification_chronometer"
            tools:text="01:23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/notification_row_spacing"
        android:textColor="@color/notification_foreground"
        android:textSize="@dimen/notification_chronometer_text_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/notification_row_spacing"
        android:textColor="@color/notification_foreground_muted"
        android:textSize="@dimen/notification_status_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/notification_row_spacing_large"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_saved_count"
            tools:text="3 saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notification_badge"
            android:paddingStart="@dimen/notification_badge_padding_horizontal"
            android:paddingTop="@dimen/notification_badge_padding_vertical"
            android:paddingEnd="@dimen/notification_badge_padding_horizontal"
            android:paddingBottom="@dimen/notification_badge_padding_vertical"
            android:textColor="@android:color/white"
            android:textSize="@dimen/notification_badge_text_size"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_notification_rewind"
            android:layout_width="@dimen/notification_action_button_size"
            android:layout_height="@dimen/notification_action_button_size"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_rewind"
            android:src="@drawable/ic_notification_rewind"
            android:tint="@color/notification_foreground" />

        <ImageButton
            android:id="@+id/btn_notification_view"
            android:layout_width="@dimen/notification_action_button_size"
            android:layout_height="@dimen/notification_action_button_size"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_view"
            android:src="@drawable/ic_notification_open"
            android:tint="@color/notification_foreground"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_notification_stop"
            android:layout_width="@dimen/notification_action_button_size"
            android:layout_height="@dimen/notification_action_button_size"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_action_stop"
            android:src="@drawable/ic_notification_stop"
            android:tint="@color/notification_foreground" />

        <LinearLayout
            android:id="@+id/notification_confirm_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_notification_cancel_stop"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/notification_action_button_size"
                android:text="@string/notification_action_cancel_stop"
                android:textColor="@color/notification_foreground" />

            <Button
                android:id="@+id/btn_notification_confirm_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/notification_badge"
                android:minHeight="@dimen/notification_action_button_size"
                android:text="@string/notification_action_confirm_stop"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
